# Copy to .env.local and fill in. Never commit real values.
#
# Public site origin, no trailing slash. Feeds canonical tags, Open Graph
# URLs, sitemap.xml, robots.txt, llms.txt and every JSON-LD @id.
#
#   Production : https://dipendraguragain.tech
#   Development: http://localhost:3000
#
# Set it explicitly in the production environment. It is also the only way to
# serve a custom domain the host does not know about.
#
# Leaving it unset is no longer a silent failure: `resolveSiteUrl` in
# src/data/seo.ts falls back to the host's own domain variable (Vercel's
# VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL), and if none of those resolve
# in production the BUILD FAILS. That is deliberate — this file's previous
# advice was to leave it unset, and the site consequently shipped with every
# canonical, the sitemap and all structured data pointing at localhost.
#
# Leaving it BLANK is correct for development: an unset value resolves to
# http://localhost:3000 on its own. Do not copy a localhost value into the
# production environment.
#
# A loopback or non-absolute value is now refused in production rather than
# trusted. `NEXT_PUBLIC_SITE_URL=http://localhost:3000` set in the production
# environment used to win unconditionally and ship localhost into every
# canonical tag, og:url, JSON-LD @id, sitemap.xml, robots.txt Sitemap line and
# llms.txt — the production guard below it never fired, because the
# configured-value branch returned first. In production such a value is now
# ignored in favour of the host's variables, and the build fails if nothing
# usable is left.
#
# Note this is a NEXT_PUBLIC_* variable, so it is inlined at BUILD time.
# Changing it in the host's dashboard does nothing until you redeploy.
NEXT_PUBLIC_SITE_URL=

# Supabase project. The publishable key is safe for the browser; the service
# role key is not and must never be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Transaction pooler connection string. The direct db host for this project is
# IPv6-only, so the pooler is the usable route.
POOLER_URL=

# Initial /admin credentials (Supabase Auth user created by the init migration).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Search-engine ownership verification, read by `searchConsoleVerification` in
# src/utils/metadata.ts and emitted as a meta tag on every page. Both are
# optional and both emit nothing when unset, so leaving these blank is correct
# until you actually have a token.
#
# Google: Search Console → Add property → URL prefix →
#   https://dipendraguragain.tech/ → HTML tag → copy the `content` value only.
#   A domain property verified by DNS TXT needs neither of these.
# Bing: Webmaster Tools → Add site → "Meta tag" → copy the `content` value.
#
# Like NEXT_PUBLIC_SITE_URL, these are inlined at build time: adding one
# requires a redeploy, not a restart.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
