# Copy to .env.local and fill in. Never commit real values.
#
# Public site origin, no trailing slash. Feeds canonical tags, Open Graph
# URLs, sitemap.xml, robots.txt and every JSON-LD @id.
#
#   Production : https://dipendraguragain.tech  <- set this in Cloudflare too
#   Development: http://localhost:3000          <- the fallback, so this is optional locally
#
# Leave it unset in production and the build logs a warning while canonicals,
# the sitemap and the structured data all point at localhost, which will get
# the real pages dropped from the index.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. The publishable key is safe for the browser; the service
# role key is not and must never be exposed with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Transaction pooler connection string. The direct db host for this project is
# IPv6-only, so the pooler is the usable route.
POOLER_URL=

# Initial /admin credentials (Supabase Auth user created by the init migration).
ADMIN_EMAIL=
ADMIN_PASSWORD=
